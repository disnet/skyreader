# Local dev config for the public linkblog site (read by $env/dynamic/private).
# Copy to .env. In production these are set as Cloudflare Pages env vars/secrets.

# The Fly.io feed proxy that serves linkblog documents + social context.
FEED_PROXY_URL=http://127.0.0.1:3000

# Optional shared secret sent as X-Proxy-Secret to the feed proxy.
# FEED_PROXY_SECRET=

# Optional overrides for the origins the page links to. Both default from the page
# host (see apiBaseFor/appUrlFor); set them for staging or non-standard hosts.
#   API_URL — backend API origin the subscribe button calls (dev: http://127.0.0.1:8787)
#   APP_URL — Skyreader app origin for "Open in Skyreader" + login (dev: http://127.0.0.1:5173)
# API_URL=http://127.0.0.1:8787
# APP_URL=http://127.0.0.1:5173
