{
  "name": "skyreader",
  "version": "0.1.1",
  "description": "Skyreader CLI - Read and manage RSS feeds from the terminal",
  "type": "module",
  "bin": {
    "skyreader": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit && prettier --check .",
    "check:types": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "rss",
    "reader",
    "cli",
    "atproto",
    "bluesky",
    "feeds"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/disnet/skyreader.git",
    "directory": "cli"
  },
  "homepage": "https://skyreader.app",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "defuddle": "^0.19.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
