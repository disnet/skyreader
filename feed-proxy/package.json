  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit && prettier --check .",
    "check:types": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
