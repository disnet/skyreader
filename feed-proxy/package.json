    "test:watch": "bun test --watch",
    "keygen:web-bot-auth": "bun run scripts/generate-web-bot-auth-key.ts"
  },
  "dependencies": {
    "@sentry/bun": "^10.76.2",
    "defuddle": "^0.19.6",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.14",
    "http-message-sig": "^0.3.0",
    "linkedom": "^0.18.14",
    "temml": "^0.13.5",
    "web-bot-auth": "^0.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
