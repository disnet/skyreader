# Optional: Set to require authentication
PROXY_SECRET=your-shared-secret-here

# Cache configuration
CACHE_TTL_SECONDS=900
STALE_TTL_SECONDS=3600

# Server
PORT=3000
DATA_DIR=./data

# Error reporting (optional). In production the SENTRY_DSN secret is provisioned
# by the Fly.io Sentry integration (`fly ext sentry create`); leave unset locally
# to disable error reporting entirely.
# SENTRY_DSN=https://...@...ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
