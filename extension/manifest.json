{
  "manifest_version": 3,
  "name": "Skyreader",
  "version": "0.1.0",
  "description": "Save the page you're reading to Skyreader.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save to Skyreader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "contextMenus", "storage", "scripting"],
  "host_permissions": ["https://api.skyreader.app/*"],
  "optional_host_permissions": ["http://127.0.0.1/*", "https://*.skyreader.app/*"]
}
